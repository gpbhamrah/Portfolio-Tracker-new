datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum InstrumentType {
  STOCK
  ETF
  INDEX
  MUTUAL_FUND
  OTHER
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  BONUS
  SPLIT
  RIGHTS
  DEPOSIT
  WITHDRAWAL
}

enum AlertCondition {
  PRICE_ABOVE
  PRICE_BELOW
  TARGET_REACHED
  STOP_LOSS
  EMA_ABOVE
  EMA_BELOW
  RSI_ABOVE
  RSI_BELOW
  PERCENT_CHANGE
  VOLUME_SPIKE
  HIGH_52_WEEK
  LOW_52_WEEK
  NIFTY_ABOVE_EMA
  NIFTY_BELOW_EMA
  SECTOR_ALLOCATION
  PORTFOLIO_DRAWDOWN
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  passwordHash  String
  name          String
  isActive      Boolean        @default(true)
  emailVerified Boolean        @default(false)
  role          Role           @default(USER)
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  settings      UserSettings?
  portfolios    Portfolio[]
  watchlists    Watchlist[]
  alerts        Alert[]
  notifications Notification[]
  transactions  Transaction[]
  holdings      Holding[]
  auditLogs     AuditLog[]

  @@index([email])
  @@map("users")
}

model UserSettings {
  id                     String   @id @default(uuid())
  userId                 String   @unique
  currency               String   @default("INR")
  timezone               String   @default("Asia/Kolkata")
  theme                  String   @default("system")
  defaultPortfolioId     String?
  emailNotifications     Boolean  @default(true)
  telegramNotifications  Boolean  @default(false)
  whatsappNotifications  Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Portfolio {
  id           String   @id @default(uuid())
  userId       String
  name         String
  description  String?
  baseCurrency String   @default("INR")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  holdings     Holding[]
  snapshots    PortfolioSnapshot[]
  alerts       Alert[]

  @@index([userId])
  @@map("portfolios")
}

model Instrument {
  id             String         @id @default(uuid())
  symbol         String         @unique
  exchange       String         @default("NSE")
  isin           String?
  name           String
  companyName    String?
  sector         String?        @default("General")
  industry       String?
  instrumentType InstrumentType @default(STOCK)
  currency       String         @default("INR")
  isActive       Boolean        @default(true)

  // Market cache & technicals
  lastPrice      Float?
  previousClose  Float?
  change         Float?
  changePercent  Float?
  dayHigh        Float?
  dayLow         Float?
  volume         Float?
  high52         Float?
  low52          Float?
  ema20          Float?
  ema50          Float?
  ema100         Float?
  ema200         Float?
  rsi14          Float?
  dataStatus     String         @default("fresh")
  lastFetchedAt  DateTime?

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  transactions   Transaction[]
  holdings       Holding[]
  watchlistItems WatchlistItem[]
  alerts         Alert[]
  priceHistory   MarketPriceHistory[]
  corporateActions CorporateAction[]

  @@index([symbol])
  @@index([sector])
  @@index([exchange])
  @@map("instruments")
}

model Transaction {
  id              String          @id @default(uuid())
  userId          String
  portfolioId     String
  instrumentId    String
  transactionType TransactionType @default(BUY)
  quantity        Float
  price           Float
  brokerage       Float           @default(0)
  taxes           Float           @default(0)
  otherCharges    Float           @default(0)
  transactionDate DateTime        @default(now())
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio  Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([portfolioId])
  @@index([instrumentId])
  @@index([transactionDate])
  @@map("transactions")
}

model Holding {
  id                  String   @id @default(uuid())
  userId              String
  portfolioId         String
  instrumentId        String
  quantity            Float
  averageBuyPrice     Float
  totalInvested       Float
  firstBuyDate        DateTime @default(now())
  lastTransactionDate DateTime @default(now())
  targetSellPrice     Float?
  stopLoss            Float?
  notes               String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio  Portfolio  @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, instrumentId])
  @@index([userId])
  @@index([portfolioId])
  @@index([instrumentId])
  @@map("holdings")
}

model Watchlist {
  id          String          @id @default(uuid())
  userId      String
  name        String
  description String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@index([userId])
  @@map("watchlists")
}

model WatchlistItem {
  id               String   @id @default(uuid())
  watchlistId      String
  instrumentId     String
  targetEntryPrice Float?
  targetSellPrice  Float?
  stopLoss         Float?
  notes            String?
  addedDate        DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  watchlist  Watchlist  @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([watchlistId, instrumentId])
  @@index([watchlistId])
  @@index([instrumentId])
  @@map("watchlist_items")
}

model Alert {
  id                   String         @id @default(uuid())
  userId               String
  portfolioId          String?
  instrumentId         String?
  conditionType        AlertCondition
  conditionValue       Float
  secondaryValue       Float?
  isActive             Boolean        @default(true)
  triggeredAt          DateTime?
  cooldownMinutes      Int            @default(60)
  notificationChannels String         @default("in_app,email")
  notes                String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio    Portfolio?    @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  instrument   Instrument?   @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([userId])
  @@index([instrumentId])
  @@index([isActive])
  @@map("alerts")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  alertId   String?
  type      String    @default("ALERT")
  title     String
  message   String
  isRead    Boolean   @default(false)
  sentAt    DateTime  @default(now())
  createdAt DateTime  @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  alert Alert? @relation(fields: [alertId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model PortfolioSnapshot {
  id             String   @id @default(uuid())
  portfolioId    String
  date           DateTime
  totalValue     Float
  investedValue  Float
  realizedPnL    Float    @default(0)
  unrealizedPnL  Float    @default(0)
  cash           Float    @default(0)
  dailyReturn    Float    @default(0)
  benchmarkValue Float?
  createdAt      DateTime @default(now())

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)

  @@unique([portfolioId, date])
  @@index([portfolioId])
  @@index([date])
  @@map("portfolio_snapshots")
}

model CorporateAction {
  id           String   @id @default(uuid())
  instrumentId String
  actionType   String // SPLIT, BONUS, DIVIDEND, RIGHTS
  ratio        String? // e.g. "1:1", "1:2"
  amount       Float?
  exDate       DateTime
  recordDate   DateTime?
  description  String?
  createdAt    DateTime @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([instrumentId])
  @@index([exDate])
  @@map("corporate_actions")
}

model MarketPriceHistory {
  id           String   @id @default(uuid())
  instrumentId String
  symbol       String
  date         DateTime
  open         Float
  high         Float
  low          Float
  close        Float
  volume       Float    @default(0)
  createdAt    DateTime @default(now())

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@unique([instrumentId, date])
  @@index([symbol, date])
  @@map("market_price_history")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  resource  String
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
